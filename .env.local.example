# ─────────────────────────────────────────────────────────
# GOOGLE DRIVE INTEGRATION
# See SETUP.md for step-by-step instructions
# ─────────────────────────────────────────────────────────

# Base64-encoded Google Service Account JSON key
# How to encode: base64 -i service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY=your_base64_encoded_service_account_json

# The Google Drive root folder ID where applications are stored
# Get this from the Drive folder URL: drive.google.com/drive/folders/{FOLDER_ID}
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# ─────────────────────────────────────────────────────────
# ADMIN DASHBOARD
# ─────────────────────────────────────────────────────────

# Secret password for accessing the admin dashboard
ADMIN_SECRET=change_this_to_a_strong_password

# ─────────────────────────────────────────────────────────
# APP CONFIG
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
